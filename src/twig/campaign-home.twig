{% extends "layout.twig" %}

{% block layout_header %}
    {% include 'partials/campaign-header.twig' %}
{% endblock %}

{% block page %}
    {# {% include 'partials/campaign-section.twig' with {
        name: 'intro',
        background_video: 'https://player.vimeo.com/progressive_redirect/playback/862522756/rendition/360p/file.mp4?loc=external&signature=3b32d3218c4daa0419a38f3c3742732083b8fe597fca6d7eaef8c741b4788dad'
    } %} #}
    {% include 'partials/campaign-section.twig' with {
        name: 'video',
        background_image: true,
        background_url: '/img/fef-background-img.jpg'
    } %}
    <div class="col-md-10 col-lg-6 mb-6 mb-lg-8 m-auto campaign-section text-content">
        <div class="p-2 p-md-4 p-xl-5 text-content--wrapper">
            <p class="">
                The For Every Future campaign launched with an ambitious vision: to raise $600 million and expand the ways Middlebury already excels. This community came together and raised nearly $650 million two years ahead of schedule.
                <br><br>
                Over 23,000 donors supported this achievement. Gifts provided $190 million for financial aid and opportunity grants, $132 million for faculty and academic programs, $102 million for experiential learning beyond the classroom and $142 million in unrestricted support.
                <br><br>
                During this time, more than 82% of undergraduate alumni—over 26,000 people—engaged with the College, including nearly 7,500 who reconnected for the first time in years.
                <br><br>
                All that’s left to say is thank you to every person who supported this campaign. Every person who decided to dream together about what the College can and will be.
            </p>
        </div>
    </div>
    <div class="paragraphs paragraphs--wide">
      {% include 'paragraphs/chart-group.twig' with {
        items: [
          {
            type: 'pie',
            title: 'The Big Picture',
            labels: ['Access $190 million','Academic Excellence $132 million','Experience $102 million','Unrestricted Support $142 million','Capital Projects $74 million'],
            datasets: [ { label: '', data: [30,20,16,22,12] } ],
            alt_text: '[description of chart goes here]'
          }
        ]
      } %}
      {% include 'paragraphs/chart-group.twig' with {
        title: 'Snapshot of Support',
        text: 'A little blurb here.',
        items: [
          { type: 'stats', number: 23, suffix: 'k', label: 'Total Donors', },
          { type: 'stats', number: 5841, label: 'New Donors', },
          { type: 'stats', number: 11, suffix: 'k+', label: 'gifts under $250', },
        ],
        alt_text: '[description of chart goes here]'
      } %}
    </div>
    {% include 'partials/campaign-section.twig' with {
        name: 'pillars',
        dark_header: true
    }%}
    {# {% include 'partials/campaign-section.twig' with {
        name: 'mega-cta-panel',
        text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
        background_image: true
    } %}
    {% include 'partials/campaign-section.twig' with {
      name: 'homepage-stats',
      dark_header: true
    } %} #}
{% endblock %} 

{% block layout_footer %}
    {% include 'partials/campaign-footer.twig' with { 
      social_links: true
    }%}
{% endblock %}

{% block layout_before_body_close %}
    {% embed 'partials/drawer.twig'
    with {
      title: 'Navigation'
    }
  %}
    {% block content %}
      {% include 'partials/drawer-nav.twig' %}
    {% endblock %}
  {% endembed %}
{% endblock %}

{% block additional_scripts %}
  <script src="js/Chart.min.js"></script>
{% endblock %}
